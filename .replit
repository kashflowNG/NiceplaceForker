modules = ["web", "nodejs-20", "bash"]

[nix]
channel = "stable-25_05"
packages = ["nodejs"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "SimpleServer"

[[workflows.workflow]]
name = "SimpleServer"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node simple_server.js"
waitForPort = 5000

[deployment]
run = ["node", "simple_server.js"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 38485
externalPort = 3000

[agent]
expertMode = true
